PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/mood_calendar
JWT_SECRET=change_me_long_random_secret
JWT_EXPIRES_IN=30d
OTP_PEPPER=change_me_otp_pepper
OTP_TTL_MINUTES=10
COOKIE_NAME=mood_calendar_token

# Optional SMTP. If empty, OTP is printed to server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mood Calendar <no-reply@example.com>"
